# Copy this file to .env and fill in the values.

# The organization's Gmail address — used to tell inbound mail (received) from outbound
# mail (sent) when computing every statistic. Required.
GMAILQUEST_ORG_EMAIL=

# Anthropic API key — used only for the NL router (the `ask` tool) and for labeling
# question-topic clusters after `gmailquest cluster`. NOT required for `gmailquest sync` or
# for any of the exact structured stats tools (top_senders, email_volume, etc).
ANTHROPIC_API_KEY=

# Optional overrides — defaults shown
# GMAILQUEST_DATA_DIR=./data
# GMAILQUEST_CREDENTIALS_PATH=./data/credentials.json
# GMAILQUEST_TOKEN_PATH=./data/token.json
# GMAILQUEST_EMBEDDING_MODEL=all-MiniLM-L6-v2
# GMAILQUEST_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
